{
  "info": {
    "name": "FestivalAPI - recorrido de prueba",
    "description": "Coleccion de solicitudes para ejecutar en orden en Postman con la API corriendo localmente. Los datos son ficticios. Los identificadores generados se guardan automaticamente como variables de coleccion. La coleccion no requiere credenciales.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Crear asistente",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/asistentes"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Ana\",\n  \"apellido\": \"Ejemplo\",\n  \"documento\": \"1{{demoSufijo}}\",\n  \"telefono\": \"0000000000\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "pm.collectionVariables.set(\"asistenteId\", pm.response.json().id);"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"demoSufijo\", String(Date.now()).slice(-8));"
            ]
          }
        }
      ]
    },
